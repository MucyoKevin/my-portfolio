# Copy to `.env.local` for development. In production set these in
# Vercel: Project -> Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# Canonical origin. THIS ONE MATTERS FOR SEO.
# ---------------------------------------------------------------------------
# Every canonical tag, the sitemap, robots.txt and every og:image URL is built
# from this. Left unset, the site falls back to Vercel's own deployment
# hostname, and locally to http://localhost:3000 — so set it to the domain you
# actually want Google to index. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://kevin-portfolio-psi.vercel.app

# Verification token from Google Search Console ("HTML tag" method). Optional:
# leave it unset and no verification meta tag is emitted.
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Resend (https://resend.com) — used by src/app/actions/contact.ts
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# "From" must be an address/domain verified in Resend
# (e.g. onboarding@resend.dev while testing, or mail@yourdomain.com live).
CONTACT_FROM_EMAIL=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=
